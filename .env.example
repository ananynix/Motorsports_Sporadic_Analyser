# Copy this file to .env (which is gitignored) and fill in your own values.
# docker-compose reads .env automatically and passes these through to the
# api service (see docker-compose.yml).

# Optional. Without this set, the tactical intent classifier in
# backend/fusion_engine.py automatically falls back to its rule-based
# keyword classifier -- the app still runs fine, just without the LLM step.
#
# Defaults to Google's Gemini API via its OpenAI-compatibility endpoint --
# get a free key (no credit card) at https://aistudio.google.com/apikey and
# paste it below. Gemini's free tier is generous enough to run this project
# indefinitely at zero cost (see fusion_engine.py for why Gemini over OpenAI).
OPENAI_API_KEY=your-gemini-api-key-here

# Optional. Defaults to Gemini's OpenAI-compatible endpoint. Override to
# point at https://api.openai.com/v1 (OpenAI), Groq, or any other
# OpenAI-compatible provider instead.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional. Model name passed to the LLM. Defaults to gemini-3.5-flash-lite
# (Gemini's free tier gives Flash-Lite models a generous daily quota). If you
# switch OPENAI_BASE_URL to OpenAI, set this to e.g. gpt-4o-mini instead.
LLM_MODEL=gemini-3.5-flash-lite
